<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Primary Rhythmic Wave 1 -->
    <path
        android:pathData="M27,67.5 C27,67.5 33.75,40.5 54,40.5 C74.25,40.5 81,67.5 81,67.5"
        android:strokeWidth="6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="27"
                android:startY="40.5"
                android:endX="81"
                android:endY="67.5"
                android:type="linear">
                <item android:color="#FFFF0080" android:offset="0.0" />
                <item android:color="#FFFF8C00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Secondary Intersecting Wave 2 -->
    <path
        android:pathData="M27,40.5 C27,40.5 33.75,67.5 54,67.5 C74.25,67.5 81,40.5 81,40.5"
        android:strokeWidth="6"
        android:strokeAlpha="0.75"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="27"
                android:startY="40.5"
                android:endX="81"
                android:endY="67.5"
                android:type="linear">
                <item android:color="#FFFF0080" android:offset="0.0" />
                <item android:color="#FFFF8C00" android:offset="1.0" />
            </gradient>
